rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- USERS / EMPLOYEES COLLECTION ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user to write/update their own profile, or allow authenticated users to register employees
      allow write: if isAuthenticated();
    }

    // --- DEPARTMENTS & DESIGNATIONS ---
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /designations/{desId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /organizationSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // --- TEAMS & TEAM MEMBERS COLLECTION ---
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /teamMembers/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- EMPLOYEES & REPORTING RELATIONSHIPS ---
    match /employees/{empId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /reportingRelationships/{relId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- TASKS COLLECTION ---
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      
      // Enforce Sales Dealer Call Daily Lock:
      // If task is a dealer call and the date has passed, reject client edits
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // --- AUDIT LOGS, NOTIFICATIONS & RECURRING TASKS ---
    match /taskAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit records
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /recurringTasks/{recId} {
      allow read, write: if isAuthenticated();
    }
  }
}
