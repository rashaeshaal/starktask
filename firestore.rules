rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Single source of truth for company head roles (Executive Director & Director Operations have identical top authority)
    function isCompanyHead() {
      let role = getUserData().role;
      return role == 'Executive Director' || role == 'Director Operations';
    }

    function isAllAccessPerformanceRole() {
      return isCompanyHead();
    }

    // Target employee is a company head
    function isTargetCompanyHead(targetData) {
      return targetData.role == 'Executive Director' || targetData.role == 'Director Operations';
    }

    // Company Management Scope (Company Heads & HR/Admin Managers)
    function isCompanyScope() {
      let role = getUserData().role;
      return isCompanyHead() || 
             role == 'General Manager' ||
             role == 'HR Manager' ||
             role == 'Admin Manager' ||
             role == 'HR & Admin Manager';
    }

    // Explicit helper for managing organization structure, employees, and teams
    function canManageOrgStructure() {
      return isCompanyScope();
    }

    // Can actor manage this specific employee target (enforcing safety rules 1a to 1e)
    function canManageTargetEmployee(targetData, isSelf) {
      // 1a. Cannot change own role, level or designation
      // 1b. Cannot deactivate own account
      let isRoleChanged = request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'level', 'designation']);
      let isDeactivatingSelf = isSelf && request.resource.data.status == 'inactive' && resource.data.status != 'inactive';
      
      return (
        isCompanyHead() && 
        !(isSelf && isRoleChanged) &&
        !isDeactivatingSelf
      ) ||
      (
        canManageOrgStructure() && 
        !isCompanyHead() && 
        !isTargetCompanyHead(targetData) &&
        !(isSelf && isRoleChanged) &&
        !isDeactivatingSelf
      );
    }

    // Department Head check
    function isDepartmentHead(dept) {
      let role = getUserData().role;
      let userDept = getUserData().department;
      return (userDept == dept) && (
        role == 'Chief Sales Officer' || role == 'CSO' ||
        role == 'Operations Head' ||
        role == 'Accounts Manager' || role == 'Accounts Executive' ||
        role == 'Brand Manager' ||
        role == 'Service Manager' ||
        role == 'Transport Manager' ||
        role == 'Warehouse In-charge' ||
        role == 'Inventory Supervisor'
      );
    }

    // Check downline membership from users document downline array
    function isDownlineMember(targetUserId) {
      return getUserData().downline != null && getUserData().downline.hasAny([targetUserId]);
    }

    function isCSO() {
      let role = getUserData().role;
      return role == 'CSO' || role == 'Chief Sales Officer';
    }

    function isOperationsHead() {
      let role = getUserData().role;
      return role == 'Operations Head';
    }

    function isAccountsManager() {
      let role = getUserData().role;
      return role == 'Accounts Manager' || role == 'Accounts Executive';
    }

    // --- USERS / EMPLOYEES COLLECTION ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canManageOrgStructure();
      allow update: if isAuthenticated() && (
        canManageTargetEmployee(resource.data, request.auth.uid == userId) ||
        (
          request.auth.uid == userId && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'photoUrl', 'avatar', 'updatedAt'])
        )
      );
      allow delete: if isAuthenticated() && canManageTargetEmployee(resource.data, request.auth.uid == userId);
    }

    // --- DEPARTMENTS & DESIGNATIONS ---
    match /departments/{deptId} {
      allow read: if true;
      allow create: if isAuthenticated() && canManageOrgStructure();
      allow update: if isAuthenticated() && canManageOrgStructure() && (
        // 1c. Cannot archive if department still has active employees
        !(request.resource.data.status == 'archived' && 
          resource.data.status != 'archived' && 
          (resource.data.activeEmployeesCount > 0 || resource.data.assignedCount > 0 || resource.data.memberCount > 0))
      );
      allow delete: if isAuthenticated() && isCompanyHead();
    }

    match /designations/{desId} {
      allow read: if true;
      allow write: if isAuthenticated() && canManageOrgStructure();
    }

    match /organizationSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() && isCompanyHead();
    }

    // --- TEAMS COLLECTION ---
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        canManageOrgStructure() || 
        (getUserData().role == 'Operations Head' && request.resource.data.departmentId in ['operations', 'warehouse', 'transportation', 'service', 'inventory', 'qc'])
      );
      allow update: if isAuthenticated() && (
        canManageOrgStructure() || 
        (getUserData().role == 'Operations Head' && resource.data.departmentId in ['operations', 'warehouse', 'transportation', 'service', 'inventory', 'qc'])
      );
      allow delete: if isAuthenticated() && (
        // 1d. Cannot delete team that still has active tasks
        (isCompanyHead() && (resource.data.activeTasksCount == null || resource.data.activeTasksCount == 0)) ||
        (canManageOrgStructure() && !isCompanyHead() && (resource.data.activeTasksCount == null || resource.data.activeTasksCount == 0)) ||
        (getUserData().role == 'Operations Head' && resource.data.departmentId in ['operations', 'warehouse', 'transportation', 'service', 'inventory', 'qc'] && (resource.data.activeTasksCount == null || resource.data.activeTasksCount == 0))
      );
    }

    // --- TEAM MEMBERS COLLECTION ---
    match /teamMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && canManageOrgStructure();
    }

    // --- TASKS COLLECTION ---
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        isAllAccessPerformanceRole() ||
        isCSO() ||
        isOperationsHead() ||
        isAccountsManager() ||
        resource.data.assignedToId == request.auth.uid ||
        resource.data.createdById == request.auth.uid ||
        resource.data.requestedBy.id == request.auth.uid ||
        (getUserData().department == resource.data.departmentId && isDepartmentHead(resource.data.departmentId)) ||
        isDownlineMember(resource.data.assignedToId)
      );

      allow create: if isAuthenticated() && (
        isCompanyScope() ||
        isCSO() ||
        isOperationsHead() ||
        isAccountsManager() ||
        request.resource.data.createdById == request.auth.uid ||
        request.resource.data.assignedToId == request.auth.uid ||
        isDownlineMember(request.resource.data.assignedToId) ||
        // Cross-department request directed to Marketing
        (request.resource.data.departmentId == 'marketing' && request.resource.data.isMarketingRequest == true) ||
        // Operations cross-branch request or linked work from Sales
        (request.resource.data.isBranchRequest == true || request.resource.data.isLinkedSalesWork == true)
      );
      
      // Updates (subtask completion, status change, approvals, payment clearance/hold)
      allow update: if isAuthenticated() && (
        isCompanyScope() ||
        isCSO() ||
        isOperationsHead() ||
        isAccountsManager() ||
        resource.data.assignedToId == request.auth.uid ||
        resource.data.createdById == request.auth.uid ||
        isDownlineMember(resource.data.assignedToId)
      );

      allow delete: if isAuthenticated() && (isCompanyScope() || isCSO() || isOperationsHead() || isAccountsManager());
    }

    // --- PRECOMPUTED DAILY STATS ({uid_date}) ---
    match /dailyStats/{statId} {
      allow read: if isAuthenticated() && (
        isAllAccessPerformanceRole() ||
        resource.data.uid == request.auth.uid ||
        isDownlineMember(resource.data.uid)
      );
      allow write: if isAuthenticated() && (isAllAccessPerformanceRole() || isCompanyScope());
    }

    // --- AUDIT LOGS, NOTIFICATIONS & RECURRING TASKS ---
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && canManageOrgStructure();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit records
    }

    match /taskAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit records
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /recurringTasks/{recId} {
      allow read, write: if isAuthenticated();
    }

    // --- CONFIDENTIAL MANAGER NOTES (HR & Leadership Only) ---
    match /employeeNotes/{noteId} {
      allow read, write: if isAuthenticated() && (
        isCompanyHead() || 
        isCompanyScope() || 
        isOperationsHead() || 
        isCSO() || 
        isAccountsManager()
      );
    }

    // --- ANNOUNCEMENTS ---
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isCompanyScope();
    }

    // --- DEALERS & DEALER BOOKINGS ---
    match /dealers/{dealerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isCompanyScope() || isCSO());
    }

    match /dealerBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isCompanyScope();
    }
  }
}
