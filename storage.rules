rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Task & Finance Attachments (Payment slips, invoices, statements as PDF or image up to 10 MB each; marketing up to 25 MB)
    match /taskAttachments/{taskId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size <= 25 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType == 'application/pdf'
                     || request.resource.contentType.matches('video/.*')
                   );
      allow delete: if isAuthenticated();
    }

    // Finance attachments (Payment slips, Invoices, Bank statements, Reconciliation proofs) up to 10 MB
    match /financeAttachments/{taskId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size <= 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType == 'application/pdf'
                   );
      allow delete: if isAuthenticated();
    }

    // Operations photos (proof of loading, delivery, repair) up to 10 MB
    match /operationsPhotos/{taskId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // General attachments / marketing deliverables
    match /marketing/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size <= 25 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType == 'application/pdf'
                     || request.resource.contentType.matches('video/.*')
                   );
      allow delete: if isAuthenticated();
    }

    // Default rule for other authenticated uploads
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size <= 25 * 1024 * 1024;
    }
  }
}
